    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "accountantToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    },
    {
      "key": "fullDay",
      "value": "2026-11-10"
    },
    {
      "key": "emptyDay",
      "value": "2026-11-13"
    }
