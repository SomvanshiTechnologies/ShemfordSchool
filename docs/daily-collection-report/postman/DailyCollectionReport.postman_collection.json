{
  "info": {
    "name": "Daily Collection Report API (local test)",
    "description": "Run the folders top to bottom. Needs the local test stack (docs/daily-collection-report/tools/run_local.sh) seeded with seed_test_data.py. Never point baseUrl at production with test credentials.",
