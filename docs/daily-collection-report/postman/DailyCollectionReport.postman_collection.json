  "item": [
    {
      "name": "0 - Authentication",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds (200)', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('access token returned', () => pm.expect(j.access_token || j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('adminToken', j.access_token || j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
