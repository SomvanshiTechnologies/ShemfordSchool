              "body": "{\n  \"report_date\": \"2026-11-10\",\n  \"currency\": \"INR\",\n  \"collections\": {\n    \"cash\": 1800.0,\n    \"cheque\": 2000.0,\n    \"dd\": 1500.0,\n    \"card\": 3400.0,\n    \"upi\": 3200.0,\n    \"online\": 1200.0,\n    \"bank_transfer\": 800.0,\n    \"bharat_qr\": 0.0\n  },\n  \"total_collection\": 13900.0,\n  \"refunds\": {\n    \"total\": 600.0,\n    \"count\": 1\n  },\n  \"net_collection\": 13300.0,\n  \"transaction_count\": 10,\n  \"generated_at\": \"2026-11-18T11:42:00.000000+00:00\",\n  \"transactions\": [\n    {\n      \"payment_id\": \"pay_test_001\",\n      \"receipt_number\": \"RCP2026TEST001\",\n      \"transaction_id\": null,\n      \"payment_date\": \"2026-11-10\",\n      \"payment_mode\": \"cash\",\n      \"amount\": 1000.0,\n      \"student_id\": \"stu_001\",\n      \"admission_number\": \"SFS2026/0001\",\n      \"academic_year\": \"2026-2027\"\n    },\n    {\n      \"payment_id\": \"pay_test_002\",\n      \"receipt_number\": \"RCP2026TEST002\",\n      \"transaction_id\": null,\n      \"payment_date\": \"2026-11-10\",\n      \"payment_mode\": \"cash\",\n      \"amount\": 500.0,\n      \"student_id\": \"stu_002\",\n      \"admission_number\": \"SFS2026/0002\",\n      \"academic_year\": \"2026-2027\"\n    },\n    {\n      \"payment_id\": \"pay_test_003\",\n      \"receipt_number\": \"RCP2026TEST003\",\n      \"transaction_id\": \"CHQ-445566\",\n      \"payment_date\": \"2026-11-10\",\n      \"payment_mode\": \"cheque\",\n      \"amount\": 2000.0,\n      \"student_id\": \"stu_001\",\n      \"admission_number\": \"SFS2026/0001\",\n      \"academic_year\": \"2026-2027\"\n    }\n  ]\n}"
            }
