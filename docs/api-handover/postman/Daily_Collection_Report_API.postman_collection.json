            },
            {
              "name": "200 OK - day using POS card/UPI/cash/cheque/BharatQR/All-modes and a split",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/reports/daily-collection?date=2026-11-12",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "reports",
                    "daily-collection"
                  ],
                  "query": [
                    {
                      "key": "date",
                      "value": "2026-11-12"
                    }
                  ]
                }
              },
              "body": "{\n  \"report_date\": \"2026-11-12\",\n  \"currency\": \"INR\",\n  \"collections\": {\n    \"cash\": 600.0,\n    \"cheque\": 450.0,\n    \"dd\": 0.0,\n    \"card\": 1000.0,\n    \"upi\": 2000.0,\n    \"online\": 1000.0,\n    \"bank_transfer\": 0.0,\n    \"bharat_qr\": 1500.0,\n    \"pos_terminal\": 600.0\n  },\n  \"total_collection\": 7150.0,\n  \"refunds\": {\n    \"total\": 0,\n    \"count\": 0\n  },\n  \"net_collection\": 7150.0,\n  \"transaction_count\": 10,\n  \"generated_at\": \"2026-11-18T12:30:00.000000+00:00\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('has the documented summary fields', () => ['report_date','currency','collections','total_collection','refunds','net_collection','transaction_count'].forEach(k => pm.expect(b).to.have.property(k)));",
                  "pm.test('currency is INR', () => pm.expect(b.currency).to.eql('INR'));",
                  "pm.test('collections always include the stable keys', () => ['cash','cheque','dd','card','upi','online','bank_transfer','bharat_qr'].forEach(k => pm.expect(b.collections).to.have.property(k)));",
                  "pm.test('total_collection equals the sum of collections', () => pm.expect(Math.round(Object.values(b.collections).reduce((a, v) => a + v, 0) * 100)).to.eql(Math.round(b.total_collection * 100)));",
                  "pm.test('net_collection = total_collection - refunds.total', () => pm.expect(Math.round(b.net_collection * 100)).to.eql(Math.round((b.total_collection - b.refunds.total) * 100)));",
                  "pm.test('report_date echoes the request', () => pm.expect(b.report_date).to.eql(pm.variables.get('reportDate')));",
                  "pm.test('summary only by default (no transactions list)', () => pm.expect(b).to.not.have.property('transactions'));"
                ]
              }
            }
          ]
        },
