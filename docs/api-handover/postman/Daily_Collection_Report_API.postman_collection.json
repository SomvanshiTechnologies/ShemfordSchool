                  "pm.test('transaction_count equals rows', () => pm.expect(b.transactions.length).to.eql(b.transaction_count));",
                  "pm.test('row amounts add up to total_collection', () => pm.expect(Math.round(b.transactions.reduce((a, t) => a + t.amount, 0) * 100)).to.eql(Math.round(b.total_collection * 100)));",
