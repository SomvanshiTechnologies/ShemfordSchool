# Shemford School — backend environment template.
# Copy to .env and fill in real values. NEVER commit the real .env (it's gitignored).

# ── Database ──────────────────────────────────────────────────────────────────
# Docker local:   mongodb://mongo:27017/?replicaSet=rs0
# Standalone:     mongodb://localhost:27017/?directConnection=true
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=shemford_school

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public base URL of this backend (used in receipts/links)
BACKEND_URL=http://localhost:8000
# Frontend URL — used in password-reset email links
FRONTEND_URL=http://localhost:3000

# ── Auth / Security ───────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-another-long-random-string
# 32-byte urlsafe base64 Fernet key — encrypts PII (bank account numbers, IFSC)
FIELD_ENCRYPTION_KEY=change-this-32-char-fernet-key==

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins. Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ── Razorpay (parent / student online self-pay) ───────────────────────────────
# Get keys: https://dashboard.razorpay.com/app/keys  (test keys → switch to live in prod)
# Webhook secret: Dashboard → Settings → Webhooks (endpoint: /api/webhook/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Ezetap / Axis POS (admin / accountant card-machine collection) ────────────
# Card-present: the backend pushes the amount to a physical terminal.
# DEMO (UAT):       EZETAP_BASE_URL=https://demo.ezetap.com
# PRODUCTION (live): EZETAP_BASE_URL=https://www.ezetap.com   (confirm host with Ezetap/Axis)
# Going live = swap these four values + register the live device. No code change.
EZETAP_BASE_URL=https://demo.ezetap.com
EZETAP_USERNAME=            # API username (e.g. 1411001141)
EZETAP_APP_KEY=             # App key (UUID)
EZETAP_ORG_CODE=SHEMFORD_FUTURISTIC_SCHOO
# Keep ON in production — only registered terminals (pos_devices) can charge.
# Set to "false" only during initial onboarding.
POS_DEVICE_WHITELIST_ENABLED=true

# ── Stripe (legacy / optional online payments) ────────────────────────────────
# Webhook endpoint: /api/webhook/stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) — password reset + fee notifications ───────────────────────
# Free API key: https://resend.com  (logs to console if blank)
RESEND_API_KEY=
SENDER_EMAIL=noreply@yourdomain.com

# ── OAuth (optional) ──────────────────────────────────────────────────────────
# Only set if using Google Sign-In via an OAuth proxy. Blank = button disabled.
OAUTH_SESSION_URL=

# ── File uploads ─────────────────────────────────────────────────────────────
MAX_REQUEST_SIZE_MB=10
